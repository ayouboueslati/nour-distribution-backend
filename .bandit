[bandit]
# Bandit configuration file for NOUR Distribution Backend

# Exclude test directories and third-party code
exclude_dirs = ['/tests/', '/venv/', '/.venv/', '/migrations/']

# Skip specific tests that are acceptable for this project:
# - B104: binding to all interfaces is acceptable for development (we use environment variables)
# - B105: hardcoded passwords in test files are marked with nosec
skips = []

# Tests to run (empty means run all)
tests = []

# Set confidence and severity
confidence_level = MEDIUM
severity_level = MEDIUM
